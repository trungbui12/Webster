@model Webster.Models.ViewModels.QuestionEditVM
@using Webster.Models.Enums

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<h2>Edit Question</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="QuestionId" />

    <!-- TEST SECTION -->
    <div class="mb-3">
        <label class="form-label">Test Section</label>
        <select asp-for="TestSectionId" class="form-select">
            @foreach (var s in ViewBag.TestSections)
            {
                <option value="@s.TestSectionId">@s.SectionType</option>
            }
        </select>
    </div>

    <!-- CONTENT -->
    <div class="mb-3">
        <label class="form-label">Question Content</label>
        <textarea asp-for="Content" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <!-- SCORE -->
    <div class="mb-3">
        <label class="form-label">Score</label>
        <input asp-for="Score" type="number" class="form-control" min="1" max="5" />
    </div>

    <!-- DIFFICULTY -->
    <div class="mb-3">
        <label class="form-label">Difficulty</label>
        <select asp-for="Difficulty"
                asp-items="Html.GetEnumSelectList<QuestionDifficulty>()"
                class="form-select">
        </select>
    </div>

    <hr />
    <h4>Answers (Choose ONE correct)</h4>

    @for (int i = 0; i < Model.Answers.Count; i++)
    {
        <div class="mb-2 border p-2 rounded">
            <input type="hidden" asp-for="Answers[@i].AnswerId" />

            <div class="input-group">
                <div class="input-group-text">
                    <input type="radio"
                           name="CorrectAnswerId"
                           value="@Model.Answers[i].AnswerId"
                           checked="@(Model.CorrectAnswerId == Model.Answers[i].AnswerId)" />
                </div>

                <input asp-for="Answers[@i].Content"
                       class="form-control"
                       placeholder="Answer @(i + 1)" />
            </div>
        </div>
    }


    <button type="submit" class="btn btn-success mt-3">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
</form>
