@model IEnumerable<Webster.Models.Entities.Question>

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Question Management";

    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    var sections = Model.Select(x => x.TestSection.SectionType.ToString()).Distinct().ToList();
}

<div class="max-w-7xl mx-auto px-6 py-10">

    <!-- HEADER -->

    <div class="flex justify-between items-center mb-8">

        <div>
            <p class="text-sm text-gray-400 mb-1">
                Dashboard / Question
            </p>

            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">
                Question Management
            </h1>

            <p class="text-gray-500 text-sm">
                Manage and organize your question bank
            </p>
        </div>

        <a asp-action="Create"
           class="flex items-center gap-2 bg-indigo-600 text-white px-5 py-2.5 rounded-lg shadow-sm hover:bg-indigo-700 transition">

            <svg xmlns="http://www.w3.org/2000/svg"
                 class="w-4 h-4"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4" />

            </svg>

            New Question
        </a>

    </div>


    <!-- TOOLBAR -->

    <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-5 mb-6">

        <div class="flex flex-wrap gap-3">

            <input type="text"
                   id="searchInput"
                   placeholder="Search questions..."
                   class="w-64 border border-gray-200 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">

            <select id="sectionFilter"
                    class="border border-gray-200 rounded-lg px-4 py-2 text-sm">

                <option value="">All Sections</option>

                @foreach (var s in sections)
                {
                    <option value="@s">@s</option>
                }

            </select>

        </div>

    </div>


    <!-- TABLE -->

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">

        <table class="w-full">

            <!-- HEADER -->

            <thead class="bg-gray-50 text-gray-600 text-sm">

                <tr>

                    <th class="text-left px-6 py-3">Question</th>

                    <th class="text-left px-6 py-3">
                        Section
                    </th>

                    <th class="text-left px-6 py-3">
                        Score
                    </th>

                    <th class="text-right px-6 py-3">
                        Actions
                    </th>

                </tr>

            </thead>


            <!-- BODY -->

            <tbody class="divide-y text-sm">

                @foreach (var q in Model)
                {
                    var isHigh = q.Score >= 5;

                    <tr id="row-@q.QuestionId"
                        class="searchable hover:bg-indigo-50 transition-all duration-200 group"
                        data-section="@q.TestSection.SectionType">

                        <!-- QUESTION -->

                        <td class="px-6 py-4">

                            <div class="font-medium text-gray-800">
                                @q.Content
                            </div>

                            <div class="text-xs text-gray-400">
                                ID: @q.QuestionId
                            </div>

                        </td>


                        <!-- SECTION -->

                        <td class="px-6 py-4">

                            <span class="px-3 py-1 text-xs rounded-full
                                        bg-blue-100 text-blue-700">

                                @q.TestSection.SectionType

                            </span>

                        </td>


                        <!-- SCORE -->

                        <td class="px-6 py-4">

                            <span class="px-3 py-1 text-xs rounded-full
                                        @(isHigh
                                                                        ? "bg-green-100 text-green-700"
                                                                        : "bg-gray-100 text-gray-600")">

                            @q.Score

                            </span>

                        </td>


                        <!-- ACTIONS -->

                        <td class="px-6 py-4 text-right">

                            <div class="flex justify-end gap-3">

                                <!-- EDIT BUTTON -->

                                <a asp-action="Edit"
                                   asp-route-id="@q.QuestionId"
                                   class="w-10 h-10 flex items-center justify-center rounded-lg bg-yellow-400 text-white hover:bg-yellow-500 transition">

                                    <i class="bi bi-pencil text-lg"></i>

                                </a>


                                <!-- DELETE BUTTON -->

                                <button class="deleteBtn w-10 h-10 flex items-center justify-center rounded-lg bg-red-500 text-white hover:bg-red-600 transition"
                                        data-id="@q.QuestionId">

                                    <i class="bi bi-trash text-lg"></i>

                                </button>

                            </div>

                        </td>

                    </tr>
                                }

            </tbody>

        </table>

    </div>


    <!-- PAGINATION -->

    <div class="flex justify-center mt-8 gap-2">

        @if (pageNumber > 1)
        {
            <a asp-action="Index"
               asp-route-page="@(pageNumber - 1)"
               class="px-3 py-1 border rounded hover:bg-gray-100">

                Prev

            </a>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               class="px-3 py-1 border rounded
                            @(i == pageNumber
                                                  ? "bg-indigo-600 text-white"
                                                  : "hover:bg-gray-100")">

            @i

            </a>
                }

        @if (pageNumber < totalPages)
        {
            <a asp-action="Index"
               asp-route-page="@(pageNumber + 1)"
               class="px-3 py-1 border rounded hover:bg-gray-100">

                Next

            </a>
        }

    </div>

</div>


<!-- DELETE MODAL -->

<div id="deleteModal"
     class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50 backdrop-blur-sm">

    <div class="bg-white rounded-2xl p-7 w-96 shadow-xl">

        <h2 class="text-lg font-semibold mb-2 text-gray-800">
            Delete Question
        </h2>

        <p class="text-gray-500 text-sm mb-6">
            Are you sure you want to delete this question?
        </p>

        <div class="flex justify-end gap-3">

            <button id="cancelDelete"
                    class="px-4 py-2 border rounded-lg hover:bg-gray-50">

                Cancel

            </button>

            <button id="confirmDelete"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">

                Delete

            </button>

        </div>

    </div>

</div>


<script>

    const searchInput = document.getElementById("searchInput");
    const sectionFilter = document.getElementById("sectionFilter");
    const rows = document.querySelectorAll(".searchable");

    function filterRows(){

        const search = searchInput.value.toLowerCase();
        const section = sectionFilter.value;

        rows.forEach(row => {

            const text = row.innerText.toLowerCase();
            const rowSection = row.dataset.section;

            const matchSearch = text.includes(search);
            const matchSection = !section || rowSection === section;

            row.style.display = (matchSearch && matchSection)
                ? ""
                : "none";

        });

    }

    searchInput.addEventListener("keyup", filterRows);
    sectionFilter.addEventListener("change", filterRows);


    let deleteId = null

    const modal = document.getElementById("deleteModal")
    const confirmDelete = document.getElementById("confirmDelete")
    const cancelDelete = document.getElementById("cancelDelete")

    document.querySelectorAll(".deleteBtn").forEach(btn => {

        btn.onclick = () => {

            deleteId = btn.dataset.id

            modal.classList.remove("hidden")
            modal.classList.add("flex")

        }

    })

    cancelDelete.onclick = () => {

        modal.classList.add("hidden")

    }

    confirmDelete.onclick = () => {

        fetch("/Question/Delete/" + deleteId, {
            method: "POST"
        })
        .then(res => {

            if (res.ok) {

                const row = document.getElementById("row-" + deleteId)

                row.style.opacity = "0"

                setTimeout(() => {
                    row.remove()
                }, 200)

                modal.classList.add("hidden")

            } else {

                alert("Delete failed")

            }

        })

    }

</script>