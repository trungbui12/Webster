@model Webster.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <meta name="viewport" content="width=device-width" />

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>

        body {
            background: linear-gradient(135deg,#0B2C5A,#0F3C78);
        }

        .glass {
            backdrop-filter: blur(20px);
            background: rgba(255,255,255,0.92);
            border: 1px solid rgba(255,255,255,0.3);
        }

        /* floating label */

        .input-group {
            position: relative;
        }

            .input-group input {
                padding-top: 20px;
            }

            .input-group label {
                position: absolute;
                left: 44px;
                top: 50%;
                transform: translateY(-50%);
                color: #6b7280;
                font-size: 14px;
                pointer-events: none;
                transition: all .2s;
                background: white;
                padding: 0 4px;
            }

            .input-group input:focus + label,
            .input-group input:not(:placeholder-shown) + label {
                top: 4px;
                font-size: 12px;
                color: #FF5E14;
            }

        /* theme */

        .btn-main {
            background: #FF5E14;
        }

            .btn-main:hover {
                background: #e55312;
            }

        .input-focus:focus {
            border-color: #FF5E14;
            box-shadow: 0 0 0 2px rgba(255,94,20,.2);
        }

        /* animation */

        .fade-in {
            animation: fadeIn .6s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }
    </style>

</head>

<body class="min-h-screen flex">

    <!-- LEFT BRANDING -->

    <div class="hidden lg:flex w-1/2 text-white flex-col justify-center px-16 relative">

        <div class="absolute w-[500px] h-[500px] bg-[#FF5E14] opacity-20 blur-3xl rounded-full top-[-150px] left-[-150px]"></div>

        <h1 class="text-5xl font-bold leading-tight mb-6 fade-in">
            Webster Recruitment System
        </h1>

        <p class="text-lg text-blue-100 max-w-md fade-in">
            A modern aptitude testing platform designed to help organizations evaluate
            candidate skills, track performance, and make smarter hiring decisions.
        </p>

        <div class="mt-10 flex gap-6 text-sm text-blue-200 fade-in">

            <div class="flex items-center gap-2">
                <i class="fa fa-check text-[#FF5E14]"></i>
                Smart Testing
            </div>

            <div class="flex items-center gap-2">
                <i class="fa fa-check text-[#FF5E14]"></i>
                Instant Results
            </div>

            <div class="flex items-center gap-2">
                <i class="fa fa-check text-[#FF5E14]"></i>
                Analytics Dashboard
            </div>

        </div>

    </div>

    <!-- RIGHT LOGIN -->

    <div class="flex-1 flex items-center justify-center px-6">

        <div class="w-full max-w-md glass shadow-2xl rounded-3xl p-10 fade-in">

            <!-- LOGO -->

            <div class="text-center mb-10">

                <div class="flex justify-center mb-4">

                    <div class="w-14 h-14 bg-[#0B2C5A] text-white rounded-xl flex items-center justify-center shadow-lg text-xl">
                        <i class="fa-solid fa-brain"></i>
                    </div>

                </div>

                <h2 class="text-3xl font-bold text-[#0B2C5A]">
                    Webster
                </h2>

                <p class="text-gray-500 text-sm mt-1">
                    Aptitude Testing Platform
                </p>

            </div>


            <form asp-action="Login" method="post" id="loginForm" class="space-y-6">

                <!-- USERNAME -->

                <div class="input-group">

                    <i class="fa fa-user absolute left-4 top-4 text-gray-400"></i>

                    <input asp-for="Username"
                           placeholder=" "
                           class="w-full border rounded-xl pl-12 pr-4 py-3 input-focus focus:outline-none" />

                    <label>Username</label>

                    <span asp-validation-for="Username"
                          class="text-red-500 text-sm"></span>

                </div>


                <!-- PASSWORD -->

                <div class="input-group">

                    <i class="fa fa-lock absolute left-4 top-4 text-gray-400"></i>

                    <input asp-for="Password"
                           type="password"
                           id="passwordInput"
                           placeholder=" "
                           class="w-full border rounded-xl pl-12 pr-12 py-3 input-focus focus:outline-none" />

                    <label>Password</label>

                    <button type="button"
                            onclick="togglePassword()"
                            class="absolute right-4 top-4 text-gray-400 hover:text-gray-600">

                        <i id="eyeIcon" class="fa fa-eye"></i>

                    </button>

                </div>


                <!-- OPTIONS -->

                <div class="flex items-center justify-between text-sm">

                    <label class="flex items-center gap-2 text-gray-600">

                        <input type="checkbox"
                               class="rounded border-gray-300">

                        Remember me

                    </label>

                    <a href="#" class="text-[#FF5E14] hover:underline">
                        Forgot password?
                    </a>

                </div>


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-100 text-red-600 p-3 rounded-lg text-sm text-center">
                        Invalid username or password
                    </div>
                }


                <!-- LOGIN BUTTON -->

                <button id="loginBtn"
                        class="w-full py-3 btn-main text-white text-lg font-semibold rounded-xl transition shadow-md flex items-center justify-center gap-2">

                    <span id="btnText">Login</span>

                    <span id="loadingSpinner" class="hidden">
                        <i class="fa fa-spinner fa-spin"></i>
                    </span>

                </button>

            </form>


            <div class="text-center text-gray-500 text-sm mt-8">

                <p class="text-[#0B2C5A] font-semibold">
                    Webster Recruitment System
                </p>

                <p class="text-xs opacity-70 mt-1">
                    © 2026 Webster Corporation
                </p>

            </div>

        </div>

    </div>


    <script>

        function togglePassword(){

        const input=document.getElementById("passwordInput")
        const icon=document.getElementById("eyeIcon")

        if(input.type==="password"){
        input.type="text"
        icon.classList.replace("fa-eye","fa-eye-slash")
        }
        else{
        input.type="password"
        icon.classList.replace("fa-eye-slash","fa-eye")
        }

        }

        document.getElementById("loginForm").addEventListener("submit",function(){

        document.getElementById("btnText").innerText="Signing in..."
        document.getElementById("loadingSpinner").classList.remove("hidden")

        })

    </script>

</body>

</html>