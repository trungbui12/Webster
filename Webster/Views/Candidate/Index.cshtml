@model IEnumerable<Webster.Models.Entities.Candidate>

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Candidate List";

    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string[] avatarColors = {
        "from-indigo-500 to-indigo-600",
        "from-purple-500 to-purple-600",
        "from-blue-500 to-blue-600",
        "from-pink-500 to-pink-600"
    };

    string[] statuses = { "Active", "Pending", "Interview" };

    var random = new Random();
}

<div class="space-y-10">

    <!-- HEADER -->

    <div class="flex justify-between items-center">

        <div>

            <p class="text-sm text-gray-400">
                Dashboard / Candidates
            </p>

            <div class="flex items-center gap-3 mt-1">

                <h1 class="text-3xl font-bold text-gray-800">
                    Candidate Management
                </h1>

                <span class="bg-indigo-100 text-indigo-600 text-xs px-3 py-1 rounded-full font-medium">
                    @Model.Count() candidates
                </span>

            </div>

        </div>

        <a asp-action="Create"
           class="flex items-center gap-2 bg-indigo-600 text-white px-5 py-2.5 rounded-lg shadow hover:bg-indigo-700 hover:scale-105 transition">

            <i class="bi bi-plus-lg"></i>
            Create Candidate

        </a>

    </div>


    <!-- STATS -->

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">

        <!-- Total Candidates -->

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100
                hover:shadow-md hover:-translate-y-1 transition">

            <div class="flex justify-between items-start">

                <div>

                    <p class="text-sm text-gray-400">
                        Total Candidates
                    </p>

                    <h2 class="text-3xl font-bold text-gray-800 mt-1">
                        @Model.Count()
                    </h2>

                    <div class="flex items-center gap-1 text-xs text-green-600 mt-2">

                        <i class="bi bi-arrow-up-right"></i>

                        <span>
                            +12% this month
                        </span>

                    </div>

                </div>

                <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center text-indigo-600">

                    <i class="bi bi-people text-xl"></i>

                </div>

            </div>

            <div class="mt-4 h-1.5 bg-gray-100 rounded-full overflow-hidden">

                <div class="h-full bg-indigo-500 w-3/4"></div>

            </div>

        </div>



        <!-- Active Candidates -->

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100
                hover:shadow-md hover:-translate-y-1 transition">

            <div class="flex justify-between items-start">

                <div>

                    <p class="text-sm text-gray-400">
                        Active Today
                    </p>

                    <h2 class="text-3xl font-bold text-gray-800 mt-1">
                        12
                    </h2>

                    <div class="flex items-center gap-1 text-xs text-green-600 mt-2">

                        <i class="bi bi-arrow-up-right"></i>

                        <span>
                            +4 today
                        </span>

                    </div>

                </div>

                <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-green-600">

                    <i class="bi bi-activity text-xl"></i>

                </div>

            </div>

            <div class="mt-4 h-1.5 bg-gray-100 rounded-full overflow-hidden">

                <div class="h-full bg-green-500 w-1/2"></div>

            </div>

        </div>



        <!-- Interviews -->

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100
                hover:shadow-md hover:-translate-y-1 transition">

            <div class="flex justify-between items-start">

                <div>

                    <p class="text-sm text-gray-400">
                        Interviews
                    </p>

                    <h2 class="text-3xl font-bold text-gray-800 mt-1">
                        6
                    </h2>

                    <div class="flex items-center gap-1 text-xs text-purple-600 mt-2">

                        <i class="bi bi-arrow-up-right"></i>

                        <span>
                            +2 scheduled
                        </span>

                    </div>

                </div>

                <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-purple-600">

                    <i class="bi bi-person-video3 text-xl"></i>

                </div>

            </div>

            <div class="mt-4 h-1.5 bg-gray-100 rounded-full overflow-hidden">

                <div class="h-full bg-purple-500 w-2/5"></div>

            </div>

        </div>



        <!-- Pending Review -->

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100
                hover:shadow-md hover:-translate-y-1 transition">

            <div class="flex justify-between items-start">

                <div>

                    <p class="text-sm text-gray-400">
                        Pending Review
                    </p>

                    <h2 class="text-3xl font-bold text-gray-800 mt-1">
                        9
                    </h2>

                    <div class="flex items-center gap-1 text-xs text-yellow-600 mt-2">

                        <i class="bi bi-clock"></i>

                        <span>
                            waiting for approval
                        </span>

                    </div>

                </div>

                <div class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center text-yellow-600">

                    <i class="bi bi-hourglass-split text-xl"></i>

                </div>

            </div>

            <div class="mt-4 h-1.5 bg-gray-100 rounded-full overflow-hidden">

                <div class="h-full bg-yellow-500 w-3/5"></div>

            </div>

        </div>

    </div>


    <!-- TABLE -->

    <div class="bg-white rounded-xl shadow overflow-hidden">

        <!-- SEARCH -->

        <div class="p-6 border-b flex justify-between items-center">

            <div class="relative w-96">

                <i class="bi bi-search absolute left-3 top-2.5 text-gray-400"></i>

                <input id="searchInput"
                       placeholder="Search candidates..."
                       class="w-full border border-gray-200 rounded-xl pl-9 pr-9 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">

                <button id="clearSearch"
                        class="absolute right-3 top-2 text-gray-400 hover:text-gray-600 hidden">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

        </div>


        <!-- HEADER -->

        <div class="sticky top-0 grid grid-cols-12 px-6 py-3 text-xs font-semibold text-gray-500 uppercase bg-gray-50 border-b">

            <div class="col-span-5">
                Candidate
            </div>

            <div class="col-span-4">
                Email
            </div>

            <div class="col-span-1">
                Status
            </div>

            <div class="col-span-2 text-right">
                Actions
            </div>

        </div>


        <!-- BODY -->
        @if (!Model.Any())
        {
            <div class="text-center py-20 text-gray-400">

                <i class="bi bi-people text-5xl mb-3"></i>

                <p class="text-lg font-medium">
                    No candidates yet
                </p>

                <p class="text-sm">
                    Create your first candidate
                </p>

            </div>
        }
        else
        {

            foreach (var c in Model)
            {

                var color = avatarColors[random.Next(avatarColors.Length)];
                var status = statuses[random.Next(statuses.Length)];
                <div class="grid grid-cols-12 px-6 py-4 items-center border-b hover:bg-indigo-50 hover:shadow-sm transition-all duration-200 searchable group">

                    <!-- Candidate -->

                    <div class="col-span-5 flex items-center gap-3">

                        <div class="w-11 h-11 rounded-full bg-gradient-to-r @color text-white flex items-center justify-center font-semibold shadow group-hover:scale-110 transition">

                            @c.FullName.Substring(0, 1)

                        </div>

                        <div>

                            <p class="font-semibold text-gray-800">
                                @c.FullName
                            </p>

                            <p class="text-xs text-gray-400">
                                ID: @c.CandidateId
                            </p>

                        </div>

                    </div>


                    <!-- Email -->

                    <div class="col-span-4 text-gray-600">
                        @c.Email
                    </div>


                    <!-- Status -->

                    <div class="col-span-1">

                        @if (status == "Active")
                        {
                            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700 font-medium">
                                Active
                            </span>
                        }
                        else if (status == "Pending")
                        {
                            <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-700 font-medium">
                                Pending
                            </span>
                        }
                        else
                        {
                            <span class="px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-700 font-medium">
                                Interview
                            </span>
                        }

                    </div>


                    <!-- Actions -->

                    <div class="col-span-2 flex justify-end gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@c.CandidateId"
                           class="w-9 h-9 flex items-center justify-center rounded-lg bg-yellow-400 text-white hover:bg-yellow-500 transition">

                            <i class="bi bi-pencil"></i>

                        </a>

                        <button class="deleteBtn w-9 h-9 flex items-center justify-center rounded-lg bg-red-500 text-white hover:bg-red-600 transition"
                                data-id="@c.CandidateId">

                            <i class="bi bi-trash"></i>

                        </button>

                    </div>

                </div>

            }

        }


        <!-- PAGINATION -->

        <div class="flex justify-center items-center gap-2 py-6">

            @if (pageNumber > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(pageNumber - 1)"
                   class="w-9 h-9 flex items-center justify-center border rounded-lg hover:bg-gray-100">

                    <i class="bi bi-chevron-left"></i>

                </a>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   class="w-9 h-9 flex items-center justify-center rounded-lg border
    @(i == pageNumber ? "bg-indigo-600 text-white border-indigo-600" : "hover:bg-gray-100")">

                    @i

                </a>
            }

            @if (pageNumber < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(pageNumber + 1)"
                   class="w-9 h-9 flex items-center justify-center border rounded-lg hover:bg-gray-100">

                    <i class="bi bi-chevron-right"></i>

                </a>
            }

        </div>

    </div>

</div>


<!-- DELETE MODAL -->

<div id="deleteModal"
     class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">

    <div class="bg-white rounded-xl p-6 w-96 shadow-xl">

        <h2 class="text-lg font-semibold mb-3">
            Delete Candidate
        </h2>

        <p class="text-gray-500 text-sm mb-6">
            Are you sure you want to delete this candidate?
        </p>

        <div class="flex justify-end gap-3">

            <button id="cancelDelete"
                    class="px-4 py-2 border rounded-lg hover:bg-gray-50">
                Cancel
            </button>

            <a id="confirmDelete"
               class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                Delete
            </a>

        </div>

    </div>

</div>


<script>

    const searchInput = document.getElementById("searchInput")
    const clearBtn = document.getElementById("clearSearch")

    searchInput.addEventListener("input", () => {

    const keyword = searchInput.value.toLowerCase()

    document.querySelectorAll(".searchable").forEach(row => {

    row.style.display =
    row.innerText.toLowerCase().includes(keyword)
    ? "grid"
    : "none"

    })

    clearBtn.style.display = keyword ? "block" : "none"

    })

    clearBtn.onclick = () => {

    searchInput.value = ""
    searchInput.dispatchEvent(new Event("input"))

    }


    const modal = document.getElementById("deleteModal")
    const confirmDelete = document.getElementById("confirmDelete")
    const cancelDelete = document.getElementById("cancelDelete")

    document.querySelectorAll(".deleteBtn").forEach(btn => {

    btn.onclick = () => {

    const id = btn.dataset.id
    confirmDelete.href = "/Candidate/Delete/" + id

    modal.classList.remove("hidden")
    modal.classList.add("flex")

    }

    })

    cancelDelete.onclick = () => {

    modal.classList.add("hidden")

    }

</script>