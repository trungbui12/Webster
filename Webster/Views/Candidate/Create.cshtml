@model Webster.Models.ViewModels.CandidateCreateVM
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="max-w-5xl mx-auto px-6 py-6">

    <!-- HEADER -->
    <div class="mb-8">
        <h2 class="text-2xl font-semibold text-gray-900">
            Create Candidate
        </h2>
        <p class="text-sm text-gray-500">
            Add a new candidate to the system
        </p>
    </div>

    <form asp-action="Create" method="post" class="space-y-8">

        <!-- VALIDATION SUMMARY -->
        <div asp-validation-summary="ModelOnly"
             class="text-red-500 text-sm"></div>

        <!-- BASIC INFO -->
        <div class="bg-white border rounded-xl p-6 shadow-sm">

            <h3 class="text-lg font-semibold text-gray-800 mb-5">
                Basic Information
            </h3>

            <div class="grid md:grid-cols-2 gap-5">

                <div>
                    <label class="form-label">
                        Full Name <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="FullName" class="form-input" />

                    <span asp-validation-for="FullName"
                          class="form-error"></span>
                </div>

                <div>
                    <label class="form-label">
                        Email <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-input" />

                    <span asp-validation-for="Email"
                          class="form-error"></span>
                </div>

                <div>
                    <label class="form-label">
                        Phone <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Phone"
                           class="form-input" />

                    <span asp-validation-for="Phone"
                          class="form-error"></span>
                </div>

                <div>
                    <label class="form-label">
                        Date of Birth <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="DateOfBirth"
                           type="date"
                           class="form-input" />

                    <span asp-validation-for="DateOfBirth"
                          class="form-error"></span>
                </div>

            </div>
        </div>


        <!-- ACCOUNT -->
        <div class="bg-white border rounded-xl p-6 shadow-sm">

            <h3 class="text-lg font-semibold text-gray-800 mb-5">
                Account
            </h3>

            <div class="grid md:grid-cols-2 gap-5">

                <div>
                    <label class="form-label">
                        Username <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Username"
                           class="form-input" />

                    <span asp-validation-for="Username"
                          class="form-error"></span>
                </div>

                <div>
                    <label class="form-label">
                        Password <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-input" />

                    <span asp-validation-for="Password"
                          class="form-error"></span>
                </div>

            </div>
        </div>


        <!-- EDUCATION -->
        <div class="bg-white border rounded-xl p-6 shadow-sm">

            <h3 class="text-lg font-semibold text-gray-800 mb-5">
                Education
            </h3>

            <div class="grid md:grid-cols-2 gap-5">

                <div>
                    <label class="form-label">
                        Degree <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Degree"
                           class="form-input" />

                    <span asp-validation-for="Degree"
                          class="form-error"></span>
                </div>

                <div>
                    <label class="form-label">
                        University <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="University"
                           class="form-input" />

                    <span asp-validation-for="University"
                          class="form-error"></span>
                </div>

                <div>
                    <label class="form-label">
                        Graduation Year <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="GraduationYear"
                           type="number"
                           class="form-input" />

                    <span asp-validation-for="GraduationYear"
                          class="form-error"></span>
                </div>

            </div>
        </div>


        <!-- EXPERIENCE -->
        <div class="bg-white border rounded-xl p-6 shadow-sm">

            <h3 class="text-lg font-semibold text-gray-800 mb-5">
                Experience
            </h3>

            <div class="grid md:grid-cols-2 gap-5">

                <div>
                    <label class="form-label">
                        Years of Experience <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="YearsOfExperience"
                           type="number"
                           class="form-input" />

                    <span asp-validation-for="YearsOfExperience"
                          class="form-error"></span>
                </div>

                <div>
                    <label class="form-label">
                        Previous Company
                    </label>

                    <input asp-for="PreviousCompany"
                           class="form-input" />

                    <span asp-validation-for="PreviousCompany"
                          class="form-error"></span>
                </div>

            </div>
        </div>


        <!-- BUTTONS -->
        <div class="flex gap-4 pt-4">

            <button type="submit"
                    class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700 transition">
                Create Candidate
            </button>

            <a asp-action="Index"
               class="bg-gray-200 px-6 py-2 rounded-lg font-medium hover:bg-gray-300 transition">
                Cancel
            </a>

        </div>

    </form>

</div>


<style>

    .form-label{
        display:block;
        font-size:14px;
        color:#4b5563;
        font-weight:500;
    }

    .form-input{
        width:100%;
        margin-top:6px;
        border:1px solid #d1d5db;
        border-radius:8px;
        padding:8px 12px;
        transition:all .2s;
    }

    .form-input:focus{
        outline:none;
        border-color:#6366f1;
        box-shadow:0 0 0 2px rgba(99,102,241,.2);
    }

    .form-error{
        color:#ef4444;
        font-size:13px;
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}