@model List<Webster.Models.ViewModels.ManagerCandidateListVM>

@{
    ViewData["Title"] = "Candidate Dashboard";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var total = ViewBag.TotalItems ?? (Model?.Count() ?? 0);
    var passed = ViewBag.TotalPassed ?? (Model?.Count(x => x.IsPassed == true) ?? 0);
    var passRate = ViewBag.PassRate ?? (total == 0 ? 0 : Math.Round((double)passed / total * 100, 1));
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>

    body {
        background: #f1f5f9;
        font-family: Inter,system-ui;
        transition: .3s;
    }

    /* DARK MODE */

    .dark-mode {
        background: #0f172a;
        color: white;
    }

        .dark-mode .stat-card,
        .dark-mode .toolbar,
        .dark-mode .card-box {
            background: #1e293b;
            color: white;
        }

    /* WRAPPER */

    .wrapper {
        max-width: 1250px;
        margin: auto;
        padding: 40px 20px;
    }

    /* HEADER */

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .title {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dark-btn {
        background: white;
        border: 1px solid #e2e8f0;
        padding: 8px 14px;
        border-radius: 10px;
        cursor: pointer;
        transition: .2s;
    }

        .dark-btn:hover {
            background: #f1f5f9;
        }

    /* STATS */

    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 24px;
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(0,0,0,.04);
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: .25s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(0,0,0,.08);
        }

    .stat-icon {
        font-size: 28px;
        opacity: .8;
    }

    /* TOOLBAR */

    .toolbar {
        background: white;
        padding: 16px;
        border-radius: 16px;
        box-shadow: 0 6px 20px rgba(0,0,0,.04);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 25px;
        align-items: center;
    }

    .input-group {
        display: flex;
        align-items: center;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 6px 10px;
        background: white;
    }

        .input-group i {
            margin-right: 6px;
            color: #64748b;
        }

        .input-group input {
            border: none;
            outline: none;
            font-size: 13px;
        }

    .toolbar select,
    .toolbar input[type=date] {
        padding: 8px 12px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        font-size: 13px;
    }

    /* BUTTON */

    .btn {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #111827;
        color: white;
        border: none;
        padding: 8px 14px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn:hover {
            background: #000;
        }

    /* CARD LIST */

    .card-box {
        background: white;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,.05);
    }

    /* PAGINATION */

    .pagination {
        margin-top: 25px;
        text-align: center;
    }

    .page-link {
        display: inline-block;
        padding: 8px 12px;
        margin: 3px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        cursor: pointer;
        font-size: 13px;
    }

        .page-link.active {
            background: #111827;
            color: white;
        }

    /* EMPTY */

    .empty {
        text-align: center;
        padding: 60px;
        color: #64748b;
        font-size: 14px;
    }

</style>

<div class="wrapper">

    <div class="header">

        <div>

            <!-- Web Map / Breadcrumb -->
            <div class="text-sm text-gray-400 mb-1">
                <i class="bi bi-house"></i>
                Dashboard
                <span class="mx-1">/</span>
                <span class="text-gray-500">Candidate</span>
            </div>

            <div class="title">
                <i class="bi bi-people-fill text-indigo-500"></i>
                Results
            </div>

        </div>

        <button onclick="toggleDark()" class="dark-btn">
            <i class="bi bi-moon"></i>
            Dark Mode
        </button>

    </div>

    <!-- STATS -->

    <div class="stats">

        <div class="stat-card">

            <div>
                <div class="text-gray-500 text-sm">Total Candidates</div>
                <div class="text-2xl font-bold">@total</div>
            </div>

            <div class="stat-icon text-blue-500">
                <i class="bi bi-person-fill"></i>
            </div>

        </div>

        <div class="stat-card">

            <div>
                <div class="text-gray-500 text-sm">Total Passed</div>
                <div class="text-2xl font-bold text-green-600">@passed</div>
            </div>

            <div class="stat-icon text-green-500">
                <i class="bi bi-check-circle-fill"></i>
            </div>

        </div>

        <div class="stat-card">

            <div>
                <div class="text-gray-500 text-sm">Pass Rate</div>
                <div class="text-2xl font-bold text-indigo-600">@passRate%</div>
            </div>

            <div class="stat-icon text-indigo-500">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

        </div>

    </div>

    <!-- TOOLBAR -->

    <div class="toolbar">

        <div class="input-group">
            <i class="bi bi-search"></i>
            <input type="text" id="search" placeholder="Search candidate..." />
        </div>

        <select id="sort">
            <option value="">Sort by Date</option>
            <option value="score_desc">Score Desc</option>
            <option value="score_asc">Score Asc</option>
        </select>

        <input type="date" id="fromDate" />
        <input type="date" id="toDate" />

        <button onclick="exportExcel()" class="btn">
            <i class="bi bi-file-earmark-excel"></i>
            Export Excel
        </button>

    </div>

    <!-- LIST -->

    <div class="card-box" id="candidateContainer">
        @Html.Partial("_CandidateList", Model)
    </div>

    <!-- PAGINATION -->

    <div class="pagination" id="pagination"></div>

</div>

<script>

    let timeout;

    function loadData(page = 1){

    const search=document.getElementById("search").value;
    const sort=document.getElementById("sort").value;
    const fromDate=document.getElementById("fromDate").value;
    const toDate=document.getElementById("toDate").value;

    fetch(`?search=${search}&sortOrder=${sort}&fromDate=${fromDate}&toDate=${toDate}&page=${page}`,{
    headers:{"X-Requested-With":"XMLHttpRequest"}
    })
    .then(res=>res.text())
    .then(html=>{
    document.getElementById("candidateContainer").innerHTML=html;
    });

    }

    document.getElementById("search").addEventListener("keyup",function(){
    clearTimeout(timeout);
    timeout=setTimeout(()=>loadData(),400);
    });

    document.getElementById("sort").addEventListener("change",()=>loadData());
    document.getElementById("fromDate").addEventListener("change",()=>loadData());
    document.getElementById("toDate").addEventListener("change",()=>loadData());

    function exportExcel(){

    const search=document.getElementById("search").value;
    const sort=document.getElementById("sort").value;
    const fromDate=document.getElementById("fromDate").value;
    const toDate=document.getElementById("toDate").value;

    window.location=`/ManagerCandidate/ExportExcel?search=${search}&sortOrder=${sort}&fromDate=${fromDate}&toDate=${toDate}`;

    }

    function toggleDark(){

    document.body.classList.toggle("dark-mode");

    localStorage.setItem(
    "dark",
    document.body.classList.contains("dark-mode")
    );

    }

    window.onload=function(){

    if(localStorage.getItem("dark")==="true"){
    document.body.classList.add("dark-mode");
    }

    }

</script>