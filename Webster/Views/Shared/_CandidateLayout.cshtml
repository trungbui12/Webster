@{
    var fullName = User.Identity?.Name ?? "Candidate";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Webster Exam</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script src="https://cdn.tailwindcss.com"></script>

    <style>

        body {
            font-family: Inter, system-ui;
        }

        /* WEBSTER COLORS */

        .webster-bg {
            background: linear-gradient(135deg,#163e73,#0f2f57);
        }

        .webster-sidebar {
            background: #0f2f57;
        }

        .webster-orange {
            background: #ff5a14;
        }

            .webster-orange:hover {
                background: #e14c0f;
            }

    </style>

</head>

<body class="bg-slate-100 text-gray-800">

    <!-- NAVBAR -->
    <header class="sticky top-0 z-50 webster-bg shadow-lg">

        <div class="max-w-7xl mx-auto px-6">

            <div class="flex items-center justify-between h-16 text-white">

                <!-- LOGO -->

                <a asp-controller="CandidateDashboard"
                   asp-action="Dashboard"
                   class="flex items-center gap-3 font-semibold">

                    <div class="w-9 h-9 rounded-lg bg-white text-[#163e73] flex items-center justify-center font-bold">
                        W
                    </div>

                    <span class="tracking-wide text-sm">
                        Webster Exam System
                    </span>

                </a>


                <!-- USER -->

                <div class="flex items-center gap-4">

                    <div class="flex items-center gap-3">

                        <div class="w-9 h-9 rounded-full bg-orange-500 flex items-center justify-center text-sm font-semibold">
                            @fullName.Substring(0, 1).ToUpper()
                        </div>

                        <span class="text-sm font-medium">
                            @fullName
                        </span>

                    </div>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="text-sm opacity-90 hover:text-orange-300">

                        Logout

                    </a>

                </div>

            </div>

        </div>

    </header>



    <div class="flex">

        <!-- SIDEBAR -->

        <aside class="w-64 min-h-screen webster-sidebar text-white">

            <div class="p-6 border-b border-blue-900">

                <p class="text-xs uppercase tracking-wider text-blue-300">
                    Candidate Portal
                </p>

            </div>


            <nav class="p-3 space-y-2">

                <!-- Dashboard -->

                <a asp-controller="CandidateDashboard"
                   asp-action="Dashboard"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm transition

@(currentAction == "Dashboard"
                   ? "bg-blue-700 text-white"
                   : "text-blue-200 hover:bg-blue-800")">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="w-5 h-5"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M3 10l9-7 9 7v11a2 2 0 01-2 2h-4a2 2 0 01-2-2V13H9v8a2 2 0 01-2 2H3z" />

                    </svg>

                    Dashboard

                </a>


                <!-- Logout -->

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm text-blue-200 hover:bg-blue-800">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="w-5 h-5"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />

                    </svg>

                    Logout

                </a>

            </nav>

        </aside>


        <!-- MAIN -->

        <main class="flex-1">

            <div class="max-w-6xl mx-auto p-8">

                <!-- PAGE HEADER -->

                <div class="mb-8">

                    <h1 class="text-3xl font-semibold text-[#163e73]">
                        @ViewData["Title"]
                    </h1>

                    <p class="text-sm text-gray-500">
                        Webster Recruitment Examination Portal
                    </p>

                </div>


                <!-- CONTENT CARD -->

                <div class="bg-white rounded-2xl shadow-lg p-10 border border-gray-100 min-h-[650px]">

                    @RenderBody()

                </div>

            </div>

        </main>

    </div>


    @RenderSection("Scripts", required: false)

</body>
</html>