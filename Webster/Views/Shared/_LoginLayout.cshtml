@model Webster.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>

        body {
            background: linear-gradient(135deg,#0B2C5A,#0F3C78);
        }

        .glass {
            backdrop-filter: blur(20px);
            background: rgba(255,255,255,0.92);
            border: 1px solid rgba(255,255,255,0.35);
        }

        .industro-btn {
            background: #FF5E14;
        }

            .industro-btn:hover {
                background: #e55312;
            }

        .industro-focus:focus {
            border-color: #FF5E14;
            box-shadow: 0 0 0 2px rgba(255,94,20,.2);
        }

    </style>

</head>

<body class="min-h-screen flex items-center justify-center overflow-hidden">

    <!-- background shapes -->

    <div class="absolute w-[500px] h-[500px] bg-[#FF5E14] opacity-20 blur-3xl rounded-full top-[-150px] left-[-150px]"></div>
    <div class="absolute w-[500px] h-[500px] bg-blue-300 opacity-20 blur-3xl rounded-full bottom-[-150px] right-[-150px]"></div>

    <div class="relative w-full max-w-xl px-6">

        <div class="glass shadow-2xl rounded-3xl p-12">

            <!-- LOGO -->

            <div class="text-center mb-10">

                <div class="flex justify-center mb-4">

                    <div class="w-14 h-14 bg-[#0B2C5A] text-white rounded-xl flex items-center justify-center shadow-lg text-xl">
                        <i class="fa-solid fa-brain"></i>
                    </div>

                </div>

                <h2 class="text-3xl font-bold text-[#0B2C5A]">
                    Webster
                </h2>

                <p class="text-gray-500 mt-1">
                    Aptitude Testing Platform
                </p>

            </div>


            <form asp-action="Login" method="post" id="loginForm" class="space-y-6">

                <!-- USERNAME -->

                <div>

                    <label class="text-sm text-gray-600 font-medium">
                        Username
                    </label>

                    <div class="relative mt-2">

                        <i class="fa fa-user absolute left-4 top-4 text-gray-400"></i>

                        <input asp-for="Username"
                               class="w-full pl-12 pr-4 py-3 border rounded-xl text-lg industro-focus focus:outline-none transition"
                               placeholder="Enter username" />

                    </div>

                    <span asp-validation-for="Username"
                          class="text-red-500 text-sm"></span>

                </div>


                <!-- PASSWORD -->

                <div>

                    <label class="text-sm text-gray-600 font-medium">
                        Password
                    </label>

                    <div class="relative mt-2">

                        <i class="fa fa-lock absolute left-4 top-4 text-gray-400"></i>

                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               class="w-full pl-12 pr-12 py-3 border rounded-xl text-lg industro-focus focus:outline-none transition"
                               placeholder="Enter password" />

                        <button type="button"
                                onclick="togglePassword()"
                                class="absolute right-4 top-4 text-gray-400 hover:text-gray-600">

                            <i id="eyeIcon" class="fa fa-eye"></i>

                        </button>

                    </div>

                </div>


                <!-- OPTIONS -->

                <div class="flex items-center justify-between text-sm">

                    <label class="flex items-center gap-2 text-gray-600">

                        <input type="checkbox" class="rounded border-gray-300">

                        Remember me

                    </label>

                    <a href="#" class="text-[#FF5E14] hover:underline">
                        Forgot password?
                    </a>

                </div>


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-100 text-red-600 p-3 rounded-lg text-sm text-center">
                        Invalid username or password
                    </div>
                }

                <!-- LOGIN BUTTON -->

                <button id="loginBtn"
                        class="w-full py-3 industro-btn text-white text-lg font-semibold rounded-xl transition shadow-md flex items-center justify-center gap-2">

                    <span id="btnText">Login</span>

                    <span id="loadingSpinner" class="hidden">
                        <i class="fa fa-spinner fa-spin"></i>
                    </span>

                </button>

            </form>


            <!-- FOOTER -->

            <div class="text-center text-gray-500 text-sm mt-8">

                <p class="text-[#0B2C5A] font-semibold">
                    Webster Recruitment System
                </p>

                <p class="text-xs mt-1 opacity-70">
                    © 2026 Webster Corporation
                </p>

            </div>

        </div>

    </div>

    <script>

        function togglePassword(){

        const input=document.getElementById("passwordInput")
        const icon=document.getElementById("eyeIcon")

        if(input.type==="password"){
        input.type="text"
        icon.classList.replace("fa-eye","fa-eye-slash")
        }
        else{
        input.type="password"
        icon.classList.replace("fa-eye-slash","fa-eye")
        }

        }

        document.getElementById("loginForm").addEventListener("submit",function(){

        document.getElementById("btnText").innerText="Signing in..."
        document.getElementById("loadingSpinner").classList.remove("hidden")

        })

    </script>

</body>
</html>