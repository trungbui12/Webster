@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    int totalCandidates = ViewBag.TotalCandidates ?? 0;
    int totalPassed = ViewBag.TotalPassed ?? 0;
    int totalFailed = ViewBag.TotalFailed ?? 0;
    int totalInProgress = ViewBag.TotalInProgress ?? 0;

    double passRate = totalCandidates == 0
        ? 0
        : (double)totalPassed / totalCandidates * 100;
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="space-y-10">

    <!-- HEADER -->

    <div class="flex justify-between items-center">

        <div>
            <p class="text-gray-400 text-sm flex items-center gap-2">
                <i class="bi bi-speedometer2"></i>
                Dashboard / Manager
            </p>

            <h1 class="text-3xl font-bold text-gray-800">
                System Overview
            </h1>
        </div>

        <div class="text-sm text-gray-500 flex items-center gap-2">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>

    </div>


    <!-- ================= KPI CARDS ================= -->

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

        <!-- Candidates -->

        <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition flex justify-between items-center">

            <div>
                <p class="text-gray-400 text-sm">Candidates</p>
                <h2 class="text-3xl font-bold text-blue-600">@totalCandidates</h2>
            </div>

            <div class="bg-blue-100 text-blue-600 p-3 rounded-lg">
                <i class="bi bi-people text-xl"></i>
            </div>

        </div>


        <!-- Sections -->

        <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition flex justify-between items-center">

            <div>
                <p class="text-gray-400 text-sm">Sections</p>
                <h2 class="text-3xl font-bold text-green-600">@ViewBag.TotalSections</h2>
            </div>

            <div class="bg-green-100 text-green-600 p-3 rounded-lg">
                <i class="bi bi-diagram-3 text-xl"></i>
            </div>

        </div>


        <!-- Questions -->

        <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition flex justify-between items-center">

            <div>
                <p class="text-gray-400 text-sm">Questions</p>
                <h2 class="text-3xl font-bold text-orange-600">@ViewBag.TotalQuestions</h2>
            </div>

            <div class="bg-orange-100 text-orange-600 p-3 rounded-lg">
                <i class="bi bi-journal-text text-xl"></i>
            </div>

        </div>


        <!-- Answers -->

        <div class="bg-white p-6 rounded-2xl shadow hover:shadow-lg transition flex justify-between items-center">

            <div>
                <p class="text-gray-400 text-sm">Answers</p>
                <h2 class="text-3xl font-bold text-cyan-600">@ViewBag.TotalAnswers</h2>
            </div>

            <div class="bg-cyan-100 text-cyan-600 p-3 rounded-lg">
                <i class="bi bi-list-check text-xl"></i>
            </div>

        </div>

    </div>



    <!-- ================= ANALYTICS ================= -->

    <div class="grid lg:grid-cols-2 gap-6">

        <!-- PASS RATE -->

        <div class="bg-white p-6 rounded-2xl shadow">

            <h3 class="font-semibold text-gray-700 mb-4 flex items-center gap-2">
                <i class="bi bi-bar-chart-line"></i>
                Pass Rate
            </h3>

            <div class="w-full bg-gray-200 rounded-full h-4">

                <div class="bg-gradient-to-r from-green-400 to-green-600 h-4 rounded-full"
                     style="width:@passRate%">
                </div>

            </div>

            <p class="text-sm text-gray-500 mt-2">
                @passRate.ToString("0.0")% candidates passed
            </p>


            <div class="grid grid-cols-3 gap-4 mt-6">

                <div class="text-center bg-green-50 p-4 rounded-xl">
                    <i class="bi bi-check-circle text-green-500"></i>
                    <p class="text-xs text-gray-500">Passed</p>
                    <h3 class="text-xl font-bold text-green-600">@totalPassed</h3>
                </div>

                <div class="text-center bg-red-50 p-4 rounded-xl">
                    <i class="bi bi-x-circle text-red-500"></i>
                    <p class="text-xs text-gray-500">Failed</p>
                    <h3 class="text-xl font-bold text-red-600">@totalFailed</h3>
                </div>

                <div class="text-center bg-gray-100 p-4 rounded-xl">
                    <i class="bi bi-hourglass-split text-gray-600"></i>
                    <p class="text-xs text-gray-500">In Progress</p>
                    <h3 class="text-xl font-bold text-gray-700">@totalInProgress</h3>
                </div>

            </div>

        </div>



        <!-- RESULT CHART -->

        <div class="bg-white p-6 rounded-2xl shadow">

            <h3 class="font-semibold text-gray-700 mb-4 flex items-center gap-2">
                <i class="bi bi-pie-chart"></i>
                Exam Result Distribution
            </h3>

            <div class="flex justify-center">

                <div class="w-60">
                    <canvas id="resultChart"></canvas>
                </div>

            </div>

        </div>

    </div>



    <!-- ================= CREATE ACTIONS ================= -->

    <div class="bg-white p-6 rounded-2xl shadow">

        <h3 class="font-semibold text-gray-700 mb-6 flex items-center gap-2">
            <i class="bi bi-lightning-charge"></i>
            Create New
        </h3>

        <div class="grid md:grid-cols-3 gap-6">


            <a asp-controller="Candidate"
               asp-action="Create"
               class="flex items-center gap-4 p-5 border rounded-xl hover:bg-gray-50 transition">

                <div class="bg-blue-100 text-blue-600 p-3 rounded-lg">
                    <i class="bi bi-person-plus"></i>
                </div>

                <div>
                    <p class="font-medium">Create Candidate</p>
                    <p class="text-xs text-gray-500">
                        Add new candidate
                    </p>
                </div>

            </a>



            <a asp-controller="Question"
               asp-action="Create"
               class="flex items-center gap-4 p-5 border rounded-xl hover:bg-gray-50 transition">

                <div class="bg-purple-100 text-purple-600 p-3 rounded-lg">
                    <i class="bi bi-patch-question"></i>
                </div>

                <div>
                    <p class="font-medium">Create Question</p>
                    <p class="text-xs text-gray-500">
                        Add new exam question
                    </p>
                </div>

            </a>



            <a asp-controller="TestSection"
               asp-action="Create"
               class="flex items-center gap-4 p-5 border rounded-xl hover:bg-gray-50 transition">

                <div class="bg-green-100 text-green-600 p-3 rounded-lg">
                    <i class="bi bi-diagram-3"></i>
                </div>

                <div>
                    <p class="font-medium">Create Section</p>
                    <p class="text-xs text-gray-500">
                        Add test section
                    </p>
                </div>

            </a>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        new Chart(document.getElementById('resultChart'), {

        type: 'doughnut',

        data: {

        labels: ['Passed','Failed','In Progress'],

        datasets: [{

        data: [
        @totalPassed,
        @totalFailed,
        @totalInProgress
        ],

        backgroundColor: [
        '#22c55e',
        '#ef4444',
        '#64748b'
        ]

        }]

        },

        options: {

        plugins: {
        legend: {
        position: 'bottom'
        }
        }

        }

        });

    </script>

}