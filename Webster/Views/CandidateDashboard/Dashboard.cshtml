@model Webster.Models.ViewModels.CandidateDashboardVM
@using Webster.Models.Enums

@{
    ViewData["Title"] = "Candidate Dashboard";
    Layout = "~/Views/Shared/_CandidateLayout.cshtml";

    var orderedSections = Model.TestSections.OrderBy(x => x.TestSectionId).ToList();
    int completedCount = orderedSections.Count(x => x.IsCompleted);
    int totalSections = orderedSections.Count;
    int progressPercent = totalSections == 0 ? 0 : (int)((double)completedCount / totalSections * 100);
}
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<style>

    @@keyframes scaleIn {
        from {
            transform: scale(.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .animate-scaleIn {
        animation: scaleIn .4s ease;
    }

    .webster-hero {
        background: linear-gradient(135deg,#163e73,#0f2f57);
    }

    .webster-progress {
        background: linear-gradient(90deg,#2563eb,#0ea5e9);
    }
</style>
<div class="max-w-7xl mx-auto px-6 py-10">

    <div class="webster-hero rounded-2xl p-8 text-white mb-10 shadow-lg">

        <div class="flex items-center justify-between">

            <div>

                <h1 class="text-3xl font-bold">
                    Welcome, @Model.FullName 
                </h1>

                <p class="text-blue-100 mt-2">
                    Complete all sections to finish your Webster aptitude test
                </p>

            </div>

            <div class="bg-white/20 backdrop-blur rounded-xl px-6 py-4 text-center">

                <p class="text-sm text-blue-100">
                    Progress
                </p>

                <p class="text-2xl font-bold">
                    @progressPercent%
                </p>

            </div>

        </div>

    </div>


    <!-- STAT CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">

        <div class="bg-white rounded-2xl shadow-md p-6 border border-gray-100">

            <p class="text-gray-500 text-sm">
                Current Status
            </p>

            @if (Model.Status == CandidateStatus.Passed)
            {
                <h2 class="text-xl font-bold text-green-600 mt-2 flex items-center gap-2">
                    PASSED 🏆
                </h2>
            }
            else
            {
                <h2 class="text-xl font-bold text-blue-600 mt-2">
                    @Model.Status
                </h2>
            }

        </div>

        <div class="bg-white rounded-2xl shadow-md p-6 border border-gray-100">

            <p class="text-gray-500 text-sm">
                Completed Sections
            </p>

            <h2 class="text-xl font-bold text-green-600 mt-2">
                @completedCount / @totalSections
            </h2>

        </div>

        <div class="bg-white rounded-2xl shadow-md p-6 border border-gray-100">

            <p class="text-gray-500 text-sm">
                Total Score
            </p>

            <h2 class="text-xl font-bold text-orange-500 mt-2">
                @(Model.TotalScore ?? 0)
            </h2>

        </div>

    </div>


    <!-- GLOBAL PROGRESS -->
    <div class="bg-white rounded-2xl shadow-md p-6 mb-10">

        <div class="flex justify-between mb-3">

            <span class="font-semibold text-gray-700">
                Overall Progress
            </span>

            <span class="text-sm text-gray-500">
                @completedCount / @totalSections sections
            </span>

        </div>

        <div class="w-full bg-gray-200 rounded-full h-4 overflow-hidden">

            <div class="webster-progress h-4 rounded-full transition-all duration-700"
                 style="width:@progressPercent%">
            </div>

        </div>

    </div>


    <!-- SECTIONS -->
    <div>

        <h2 class="text-lg font-semibold text-gray-800 mb-6">
            Test Sections
        </h2>

        <div class="grid md:grid-cols-2 gap-6">

            @for (int i = 0; i < orderedSections.Count; i++)
            {
                var s = orderedSections[i];
                bool isLocked = i > 0 && !orderedSections[i - 1].IsCompleted;

                string icon = s.SectionType.ToString() switch
                {
                    "GeneralKnowledge" => "🌍",
                    "Mathematics" => "📊",
                    "ComputerTechnology" => "💻",
                    _ => "📄"
                };

                int sectionProgress = s.IsCompleted ? 100 : s.IsStarted ? 50 : 0;

                <div class="group bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-xl transition duration-300 relative overflow-hidden">

                    <!-- HOVER ACCENT BAR -->
                    <div class="absolute left-0 top-0 h-full w-1 bg-blue-600 opacity-0 group-hover:opacity-100 transition"></div>

                    <!-- HEADER -->
                    <div class="flex items-center justify-between mb-5">

                        <div class="flex items-center gap-3">

                            <div class="w-11 h-11 rounded-xl bg-blue-100 flex items-center justify-center text-xl">
                                @icon
                            </div>

                            <div>

                                <p class="font-semibold text-gray-900">
                                    @s.SectionType
                                </p>

                                <p class="text-xs text-gray-400">
                                    Section @(i + 1)
                                </p>

                            </div>

                        </div>

                        @if (s.IsCompleted)
                        {
                            <span class="text-xs bg-green-100 text-green-700 px-3 py-1 rounded-full">
                                Completed
                            </span>
                        }
                        else if (s.IsStarted)
                        {
                            <span class="text-xs bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full">
                                In Progress
                            </span>
                        }
                        else if (isLocked)
                        {
                            <span class="text-xs bg-gray-200 text-gray-600 px-3 py-1 rounded-full">
                                Locked
                            </span>
                        }
                        else
                        {
                            <span class="text-xs bg-blue-100 text-blue-700 px-3 py-1 rounded-full">
                                Ready
                            </span>
                        }

                    </div>


                    <!-- PROGRESS BAR -->
                    <div class="mb-5">

                        <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">

                            <div class="bg-gradient-to-r from-blue-500 to-indigo-600 h-2 rounded-full transition-all duration-500"
                                 style="width:@sectionProgress%">
                            </div>

                        </div>

                    </div>


                    <!-- INFO -->
                    <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 mb-6">

                        <div class="flex items-center gap-2">
                            📄 <span>@s.QuestionCount Questions</span>
                        </div>

                        <div class="flex items-center gap-2">
                            ⏱ <span>@s.TimeLimit min</span>
                        </div>

                    </div>


                    <!-- FOOTER -->
                    <div class="flex items-center justify-between">

                        <div class="text-sm text-gray-500">
                            Score:
                            <span class="font-semibold text-gray-900">
                                @(s.IsCompleted? s.Score.ToString() : "-")
                            </span>
                        </div>


                        @if (isLocked)
                        {
                            <span class="text-gray-400 text-sm">
                                🔒 Locked
                            </span>
                        }
                        else if (!s.IsStarted)
                        {
                            <button onclick="openInstruction(
                        '@Url.Action("Start", "CandidateTest", new { testSectionId = s.TestSectionId })',
                        '@s.SectionType',
                        @s.QuestionCount,
                        @s.TimeLimit
                    )"
                                    class="px-4 py-2 bg-orange-500 text-white rounded-lg text-sm font-semibold hover:bg-orange-600 transition">

                                Start Test

                            </button>
                        }
                        else if (!s.IsCompleted)
                        {
                            <a asp-controller="CandidateTest"
                               asp-action="Test"
                               asp-route-testSectionId="@s.TestSectionId"
                               class="px-4 py-2 bg-yellow-500 text-white rounded-lg text-sm font-semibold hover:bg-yellow-600 transition">

                                Continue

                            </a>
                        }
                        else
                        {
                            <span class="text-green-600 text-sm font-semibold">
                                ✔ Finished
                            </span>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</div>


<!-- ========================= -->
<!-- EXAM INSTRUCTION MODAL -->
<!-- ========================= -->

<div id="instructionModal"
     class="fixed inset-0 bg-black bg-opacity-60 hidden items-center justify-center z-50">

    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full p-8">

        <!-- TITLE -->
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
            📝 Exam Instructions
        </h2>

        <!-- EXAM INFO -->
        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-5 mb-6">

            <div class="grid grid-cols-2 gap-5 text-sm">

                <div>
                    <p class="text-gray-500">Section</p>
                    <p id="modalSectionName"
                       class="font-semibold text-gray-800 text-base"></p>
                </div>

                <div>
                    <p class="text-gray-500">Questions</p>
                    <p id="modalQuestions"
                       class="font-semibold text-gray-800 text-base"></p>
                </div>

                <div>
                    <p class="text-gray-500">Time Limit</p>
                    <p id="modalTime"
                       class="font-semibold text-gray-800 text-base"></p>
                </div>

                <div>
                    <p class="text-gray-500">Attempt</p>
                    <p class="font-semibold text-gray-800 text-base">
                        Single Attempt Only
                    </p>
                </div>

            </div>

        </div>


        <!-- RULES -->
        <div class="mb-6">

            <h3 class="font-semibold text-gray-800 mb-3">
                ⚠ Exam Rules
            </h3>

            <ul class="text-sm text-gray-600 space-y-2 list-disc pl-5">

                <li>
                    You must complete the test within the given time.
                </li>

                <li>
                    Once started, the timer cannot be paused.
                </li>

                <li>
                    Leaving fullscreen mode may terminate your exam.
                </li>

                <li>
                    Do not refresh or close the browser.
                </li>

                <li>
                    Switching tabs may be detected as cheating.
                </li>

                <li>
                    Each section can only be attempted once.
                </li>

            </ul>

        </div>


        <!-- WARNING -->
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg p-4 mb-6 text-sm">

            ⚠ Make sure you have a stable internet connection before starting the test.

        </div>


        <!-- CONFIRM -->
        <div class="flex items-center mb-6">

            <input id="confirmCheck"
                   type="checkbox"
                   class="w-4 h-4 mr-2">

            <label class="text-sm text-gray-700">
                I have read and understood all instructions.
            </label>

        </div>


        <!-- BUTTONS -->
        <div class="flex justify-end gap-3">

            <button onclick="closeInstruction()"
                    class="px-4 py-2 text-sm bg-gray-200 rounded-lg hover:bg-gray-300">
                Cancel
            </button>

            <button id="startExamBtn"
                    onclick="startExam()"
                    class="px-6 py-2 text-sm bg-indigo-600 text-white rounded-lg opacity-50 pointer-events-none hover:bg-indigo-700">
                Start Exam
            </button>

        </div>

    </div>
</div>

@if (Model.Status == CandidateStatus.Passed)
{

    <div id="passModal"
         class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50">

        <div class="bg-white rounded-2xl shadow-2xl max-w-xl w-full p-8 text-center animate-scaleIn">

            <div class="text-6xl mb-4 animate-bounce">
                🎉
            </div>

            <h2 class="text-2xl font-bold text-green-600 mb-3">
                Congratulations!
            </h2>

            <p class="text-gray-600 mb-6">
                You have successfully passed the Webster Aptitude Test.
            </p>

            <div class="bg-green-50 border border-green-100 rounded-xl p-6 mb-6">

                <p class="text-sm text-gray-500">
                    Your Final Score
                </p>

                <p class="text-3xl font-bold text-green-600 mt-1">
                    @(Model.TotalScore ?? 0)
                </p>

            </div>

            <p class="text-sm text-gray-500 mb-6">
                Our recruitment team will contact you soon.
            </p>

            <button onclick="closePassModal()"
                    class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">

                Continue

            </button>

        </div>

    </div>

}

<script>

    let startUrl = "";
    let examStarted = false;


    // ===== CONFETTI WHEN PASS =====

    document.addEventListener("DOMContentLoaded",function(){

        let modal = document.getElementById("passModal");

        if(modal){

            confetti({
                particleCount:150,
                spread:70,
                origin:{y:0.6}
            });

        }

    });


    // ===== OPEN INSTRUCTION =====

    function openInstruction(url, section, questions, time) {

        startUrl = url;

        document.getElementById("modalSectionName").innerText = section;
        document.getElementById("modalQuestions").innerText = questions;
        document.getElementById("modalTime").innerText = time + " minutes";

        document.getElementById("instructionModal").classList.remove("hidden");
        document.getElementById("instructionModal").classList.add("flex");

    }


    // ===== CLOSE INSTRUCTION =====

    function closeInstruction() {

        document.getElementById("instructionModal").classList.add("hidden");

    }


    // ===== ENABLE START BUTTON =====

    const confirmCheck = document.getElementById("confirmCheck");

    if(confirmCheck){

    confirmCheck.addEventListener("change",function(){

        const btn = document.getElementById("startExamBtn");

        if(this.checked)
            btn.classList.remove("opacity-50","pointer-events-none");
        else
            btn.classList.add("opacity-50","pointer-events-none");

    });

    }


    // ===== START EXAM =====

    function startExam(){

        examStarted = true;

        enterFullscreen();

        showCountdown();

    }


    // ===== COUNTDOWN =====

    function showCountdown(){

        let modal = document.querySelector("#instructionModal .bg-white");

        modal.innerHTML = `
            <div class="text-center py-16">

                <h2 class="text-2xl font-bold mb-4">
                    🚀 Exam Starting
                </h2>

                <p class="text-gray-500 mb-8">
                    Please stay focused. Good luck!
                </p>

                <div id="countdown"
                     class="text-6xl font-bold text-indigo-600 animate-pulse">
                     3
                </div>

            </div>
        `;

        let count = 3;

        let timer = setInterval(function(){

            count--;

            document.getElementById("countdown").innerText = count;

            if(count === 0){

                clearInterval(timer);

                window.location.href = startUrl;

            }

        },1000);

    }


    // ===== FULLSCREEN =====

    function enterFullscreen(){

        if(document.documentElement.requestFullscreen)
            document.documentElement.requestFullscreen();

    }


    // ===== CLOSE PASS MODAL =====

    function closePassModal(){

        let modal = document.getElementById("passModal");

        if(modal)
            modal.style.display="none";

    }

</script>