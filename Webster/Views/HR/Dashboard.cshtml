@model List<Webster.Models.Entities.PassedCandidate>

@{
    ViewData["Title"] = "HR Dashboard";
    Layout = "~/Views/Shared/_HRLayout.cshtml";

    var total = (int)ViewBag.TotalCandidates;
    var passed = (int)ViewBag.PassedCandidates;
    var failed = (int)ViewBag.FailedCandidates;

    var passRate = total == 0 ? 0 : (passed * 100 / total);
}

<div class="max-w-7xl mx-auto px-4">

    <!-- HEADER -->
    <div class="flex justify-between items-center mb-10">

        <div>
            <h1 class="text-4xl font-bold text-gray-800">HR Dashboard</h1>
            <p class="text-gray-500 mt-1">
                Manage and review candidate results
            </p>
        </div>

        <div class="text-right">
            <p class="text-gray-400 text-sm">Today</p>
            <p class="font-semibold text-gray-700">
                @DateTime.Now.ToString("dd MMM yyyy")
            </p>
        </div>

    </div>


    <!-- STATISTICS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">

        <!-- TOTAL -->
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 text-white p-6 rounded-xl shadow-lg">

            <p class="opacity-80">Total Candidates</p>

            <div class="flex justify-between items-center mt-2">

                <h2 class="text-4xl font-bold">
                    @total
                </h2>

                <div class="text-4xl opacity-80">
                    👥
                </div>

            </div>

        </div>


        <!-- PASSED -->
        <div class="bg-gradient-to-r from-green-500 to-green-600 text-white p-6 rounded-xl shadow-lg">

            <p class="opacity-80">Passed</p>

            <div class="flex justify-between items-center mt-2">

                <h2 class="text-4xl font-bold">
                    @passed
                </h2>

                <div class="text-4xl opacity-80">
                    ✅
                </div>

            </div>

        </div>


        <!-- FAILED -->
        <div class="bg-gradient-to-r from-red-500 to-red-600 text-white p-6 rounded-xl shadow-lg">

            <p class="opacity-80">Failed</p>

            <div class="flex justify-between items-center mt-2">

                <h2 class="text-4xl font-bold">
                    @failed
                </h2>

                <div class="text-4xl opacity-80">
                    ❌
                </div>

            </div>

        </div>

    </div>



    <!-- PASS RATE -->
    <div class="bg-white p-6 rounded-xl shadow mb-10">

        <div class="flex justify-between mb-2">

            <span class="font-semibold text-gray-700">
                Pass Rate
            </span>

            <span class="text-blue-600 font-bold">
                @passRate%
            </span>

        </div>

        <div class="w-full bg-gray-200 h-3 rounded">

            <div class="bg-blue-600 h-3 rounded"
                 style="width:@passRate%">
            </div>

        </div>

    </div>



    <!-- SEARCH -->
    <div class="flex justify-between items-center mb-6">

        <form method="get" class="relative">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search candidate..."
                   class="pl-10 pr-4 py-2 border rounded-lg w-80 focus:ring-2 focus:ring-blue-400 focus:outline-none">

            <span class="absolute left-3 top-2.5 text-gray-400">
                🔍
            </span>

        </form>

    </div>



    <!-- TABLE -->
    <div class="bg-white rounded-xl shadow overflow-hidden">

        <table class="w-full">

            <thead class="bg-gray-100 text-gray-600 text-sm">

                <tr>
                    <th class="p-4 text-left">Candidate</th>
                    <th class="p-4 text-left">Contact</th>
                    <th class="p-4 text-left">Score</th>
                    <th class="p-4 text-left">Status</th>
                    <th class="p-4 text-left">Passed Date</th>
                    <th class="p-4 text-left">Action</th>
                </tr>

            </thead>

            <tbody class="divide-y">

                @foreach (var item in Model)
                {

                    var score = item.Candidate.TestResult?.TotalScore ?? 0;

                    <tr class="hover:bg-gray-50 transition">

                        <!-- Candidate -->
                        <td class="p-4 flex items-center gap-3">

                            <div class="w-10 h-10 bg-blue-500 text-white flex items-center justify-center rounded-full font-bold">
                                @item.Candidate.FullName.Substring(0, 1)
                            </div>

                            <span class="font-semibold">
                                @item.Candidate.FullName
                            </span>

                        </td>

                        <!-- Contact -->
                        <td class="p-4 text-sm text-gray-600">

                            <div>@item.Candidate.Email</div>
                            <div class="text-gray-400">
                                @item.Candidate.Phone
                            </div>

                        </td>

                        <!-- Score -->
                        <td class="p-4 font-semibold">

                            <span class="px-3 py-1 rounded-full
                                    @(score >= 80 ? "bg-green-100 text-green-700" :
                                                                  score >= 60 ? "bg-yellow-100 text-yellow-700" :
                                                                                "bg-red-100 text-red-700")">

                            @score

                            </span>

                        </td>


                        <!-- Status -->
                        <td class="p-4">

                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">
                                Passed
                            </span>

                        </td>


                        <!-- Date -->
                        <td class="p-4 text-gray-500">

                            @item.PassedDate.ToString("dd/MM/yyyy")

                        </td>


                        <!-- Action -->
                        <td class="p-4">

                            <a asp-action="ViewProfile"
                               asp-route-id="@item.CandidateId"
                               class="bg-blue-600 text-white px-4 py-1 rounded-lg hover:bg-blue-700 transition">

                                View Profile

                            </a>

                        </td>

                    </tr>

                                }

            </tbody>

        </table>

    </div>



    <!-- PAGINATION -->
    <div class="flex justify-center mt-8 gap-2">

        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {

            <a asp-action="Dashboard"
               asp-route-page="@i"
               asp-route-search="@ViewBag.Search"
               class="px-4 py-2 border rounded-lg
                    @(i == (int)ViewBag.CurrentPage
                                   ? "bg-blue-600 text-white border-blue-600"
                                   : "bg-white hover:bg-gray-100")">

            @i

            </a>

                }

    </div>

</div>