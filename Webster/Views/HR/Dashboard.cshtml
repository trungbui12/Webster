@model List<Webster.Models.Entities.PassedCandidate>

@{
    ViewData["Title"] = "HR Dashboard";
    Layout = "~/Views/Shared/_HRLayout.cshtml";

    var total = (int)ViewBag.TotalCandidates;
    var passed = (int)ViewBag.PassedCandidates;
    var failed = (int)ViewBag.FailedCandidates;

    var passRate = total == 0 ? 0 : (passed * 100 / total);
}

<div class="max-w-7xl mx-auto px-4">

    <!-- HEADER -->
    <div class="flex justify-between items-center mb-10">

        <div>
            <h1 class="text-4xl font-bold text-gray-800 flex items-center gap-2">
                <i class="bi bi-speedometer2 text-blue-600"></i>
                HR Dashboard
            </h1>

            <p class="text-gray-500 mt-1">
                Manage and review candidate results
            </p>

        </div>

        <div class="text-right">

            <p class="text-gray-400 text-sm">Today</p>

            <p class="font-semibold text-gray-700">
                @DateTime.Now.ToString("dd MMM yyyy")
            </p>

        </div>

    </div>


    <!-- STATISTICS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">

        <!-- TOTAL -->
        <div class="bg-white p-6 rounded-xl shadow hover:shadow-lg transition">

            <div class="flex justify-between items-center">

                <div>

                    <p class="text-gray-500 text-sm">Total Candidates</p>

                    <h2 class="text-3xl font-bold text-gray-800">
                        @total
                    </h2>

                </div>

                <i class="bi bi-people text-4xl text-blue-500"></i>

            </div>

        </div>


        <!-- PASSED -->
        <div class="bg-white p-6 rounded-xl shadow hover:shadow-lg transition">

            <div class="flex justify-between items-center">

                <div>

                    <p class="text-gray-500 text-sm">Passed</p>

                    <h2 class="text-3xl font-bold text-green-600">
                        @passed
                    </h2>

                </div>

                <i class="bi bi-trophy text-4xl text-green-500"></i>

            </div>

        </div>

    </div>



    <!-- PASS RATE -->
    <div class="bg-white p-6 rounded-xl shadow mb-10">

        <div class="flex justify-between mb-2">

            <span class="font-semibold text-gray-700 flex items-center gap-2">

                <i class="bi bi-bar-chart"></i>
                Pass Rate

            </span>

            <span class="text-blue-600 font-bold">
                @passRate%
            </span>

        </div>

        <div class="w-full bg-gray-200 h-3 rounded">

            <div class="bg-blue-600 h-3 rounded"
                 style="width:@passRate%">
            </div>

        </div>

    </div>



    <!-- SEARCH -->
    <div class="flex justify-between items-center mb-6">

        <form method="get" class="relative">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search candidate..."
                   class="pl-10 pr-4 py-2 border rounded-lg w-80 focus:ring-2 focus:ring-blue-400 focus:outline-none">

            <i class="bi bi-search absolute left-3 top-2.5 text-gray-400"></i>

        </form>

    </div>



    <!-- TABLE -->
    <div class="bg-white rounded-xl shadow overflow-hidden">

        <table class="w-full">

            <thead class="bg-gray-100 text-gray-600 text-sm">

                <tr>
                    <th class="p-4 text-left">Candidate</th>
                    <th class="p-4 text-left">Contact</th>
                    <th class="p-4 text-left">Score</th>
                    <th class="p-4 text-left">Status</th>
                    <th class="p-4 text-left">Passed Date</th>
                    <th class="p-4 text-left">Action</th>
                </tr>

            </thead>

            <tbody class="divide-y">

                @foreach (var item in Model)
                {
                    var score = item.Candidate.TestResult?.TotalScore ?? 0;

                    <tr class="hover:bg-gray-50 transition">

                        <!-- Candidate -->
                        <td class="p-4 flex items-center gap-3">

                            <div class="w-10 h-10 bg-blue-500 text-white flex items-center justify-center rounded-full font-bold">
                                @item.Candidate.FullName.Substring(0, 1)
                            </div>

                            <span class="font-semibold">
                                @item.Candidate.FullName
                            </span>

                        </td>


                        <!-- Contact -->
                        <td class="p-4 text-sm text-gray-600 space-y-1">

                            <div class="flex items-center gap-2">

                                <i class="bi bi-envelope text-gray-400"></i>
                                @item.Candidate.Email

                            </div>

                            <div class="flex items-center gap-2 text-gray-400">

                                <i class="bi bi-telephone"></i>
                                @item.Candidate.Phone

                            </div>

                        </td>


                        <!-- Score -->
                        <td class="p-4 font-semibold">

                            <span class="px-3 py-1 rounded-full
    @(score >= 80 ? "bg-green-100 text-green-700" :
                                  score >= 60 ? "bg-yellow-100 text-yellow-700" :
                                  "bg-red-100 text-red-700")">

                            <i class="bi bi-star-fill mr-1"></i>
                            @score

                            </span>

                        </td>


                        <!-- Status -->
                        <td class="p-4">

                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm flex items-center gap-1 w-fit">

                                <i class="bi bi-check-circle"></i>
                                Passed

                            </span>

                        </td>


                        <!-- Date -->
                        <td class="p-4 text-gray-500">

                            <i class="bi bi-calendar-event mr-1"></i>
                            @item.PassedDate.ToString("dd/MM/yyyy")

                        </td>


                        <!-- Action -->
                        <td class="p-4">

                            <a asp-action="ViewProfile"
                               asp-route-id="@item.CandidateId"
                               class="flex items-center gap-2 bg-blue-600 text-white px-4 py-1 rounded-lg hover:bg-blue-700 transition w-fit">

                                <i class="bi bi-eye"></i>
                                View

                            </a>

                        </td>

                    </tr>
                                }

            </tbody>

        </table>

    </div>


</div>
@if (TempData["InterviewSuccess"] != null)
{
    <script>
        alert("@TempData["InterviewSuccess"]");
    </script>
}