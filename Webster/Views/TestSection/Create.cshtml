@model Webster.Models.ViewModels.TestSectionCreateVM
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<h2>Create Test Section</h2>

<form asp-action="Create" method="post">
    <div class="mb-2">
        <label>Section Type</label>
        <select asp-for="SectionType"
                asp-items="Html.GetEnumSelectList<Webster.Models.Enums.TestSectionType>()"
                class="form-select"></select>
    </div>

    <div class="mb-2">
        <label>Duration (minutes)</label>
        <input asp-for="DurationInMinutes" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Total Questions</label>
        <input asp-for="TotalQuestions" class="form-control" />
    </div>

    <button class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
