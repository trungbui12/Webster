@model IEnumerable<Webster.Models.Entities.TestSection>

@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "Test Section Management";
}

<div class="space-y-10">

    <!-- HEADER -->
    <div class="flex justify-between items-center">

        <div>
            <p class="text-sm text-gray-400">Dashboard / Test Sections</p>

            <h1 class="text-3xl font-bold text-gray-800 mt-1">
                Test Section Management
            </h1>
        </div>

        <a asp-action="Create"
           class="flex items-center gap-2 bg-indigo-600 text-white px-5 py-2.5 rounded-lg shadow hover:bg-indigo-700 transition">

            <i class="bi bi-plus-lg"></i>
            Create Section

        </a>

    </div>


    <!-- STATS -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">

        <!-- TOTAL SECTIONS -->
        <div class="bg-gradient-to-r from-indigo-600 to-indigo-500 text-white p-6 rounded-xl shadow-lg flex justify-between items-center hover:scale-[1.02] transition">

            <div>
                <p class="text-sm opacity-80">Total Sections</p>

                <p class="text-3xl font-bold mt-2">
                    @Model.Count()
                </p>
            </div>

            <i class="bi bi-diagram-3 text-5xl opacity-30"></i>

        </div>


        <!-- TOTAL QUESTIONS -->
        <div class="bg-white p-6 rounded-xl shadow border flex justify-between items-center hover:shadow-lg transition">

            <div>
                <p class="text-sm text-gray-500">Total Questions</p>

                <p class="text-3xl font-bold text-green-600 mt-2">
                    @Model.Sum(s => s.TotalQuestions)
                </p>
            </div>

            <i class="bi bi-journal-text text-4xl text-green-500"></i>

        </div>


        <!-- TOTAL DURATION -->
        <div class="bg-white p-6 rounded-xl shadow border flex justify-between items-center hover:shadow-lg transition">

            <div>
                <p class="text-sm text-gray-500">Total Duration</p>

                <p class="text-3xl font-bold text-indigo-600 mt-2">
                    @Model.Sum(s => s.DurationInMinutes) min
                </p>
            </div>

            <i class="bi bi-clock text-4xl text-indigo-500"></i>

        </div>


        <!-- AVG QUESTIONS -->
        <div class="bg-white p-6 rounded-xl shadow border flex justify-between items-center hover:shadow-lg transition">

            <div>
                <p class="text-sm text-gray-500">Avg Questions</p>

                <p class="text-3xl font-bold text-purple-600 mt-2">
                    @(Model.Any() ? Math.Round(Model.Average(s => s.TotalQuestions), 1) : 0)
                </p>
            </div>

            <i class="bi bi-bar-chart text-4xl text-purple-500"></i>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="bg-white rounded-xl shadow overflow-hidden">

        <!-- SEARCH + TOOLBAR -->
        <div class="flex justify-between items-center p-6 border-b">

            <div class="relative w-80">

                <i class="bi bi-search absolute left-3 top-3 text-gray-400"></i>

                <input id="searchInput"
                       placeholder="Search section..."
                       class="w-full border border-gray-200 rounded-lg pl-9 pr-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none">

            </div>

            <p class="text-sm text-gray-400">
                @Model.Count() sections
            </p>

        </div>


        <!-- EMPTY STATE -->
        @if (!Model.Any())
        {

            <div class="text-center py-20 text-gray-400">

                <i class="bi bi-diagram-3 text-5xl mb-3"></i>

                <p class="text-lg">No test sections found</p>

            </div>

        }
        else
        {

            <!-- SECTION GRID -->
            <div id="sectionContainer"
                 class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">

                @foreach (var s in Model)
                {

                    <div id="row-@s.TestSectionId"
                         class="searchable border rounded-xl p-6 hover:shadow-xl hover:-translate-y-1 transition bg-white">

                        <!-- CARD HEADER -->
                        <div class="flex justify-between items-center mb-5">

                            <div class="flex items-center gap-3">

                                <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center">

                                    <i class="bi bi-diagram-3"></i>

                                </div>

                                <div>

                                    <h3 class="font-semibold text-gray-800">
                                        @s.SectionType
                                    </h3>

                                    <p class="text-xs text-gray-400">
                                        ID: @s.TestSectionId
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- SECTION INFO -->
                        <div class="space-y-3 mb-6">

                            <div class="flex justify-between text-sm">

                                <span class="text-gray-500 flex items-center gap-2">
                                    <i class="bi bi-clock"></i>
                                    Duration
                                </span>

                                <span class="font-semibold text-indigo-600">
                                    @s.DurationInMinutes min
                                </span>

                            </div>


                            <div class="flex justify-between text-sm">

                                <span class="text-gray-500 flex items-center gap-2">
                                    <i class="bi bi-journal-text"></i>
                                    Questions
                                </span>

                                <span class="font-semibold text-green-600">
                                    @s.TotalQuestions
                                </span>

                            </div>

                        </div>


                        <!-- ACTIONS -->
                        <div class="flex gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@s.TestSectionId"
                               class="flex-1 text-center px-3 py-2 text-sm rounded-lg bg-yellow-400 text-white hover:bg-yellow-500 transition">

                                <i class="bi bi-pencil"></i>
                                Edit

                            </a>

                            <button class="deleteBtn flex-1 text-center px-3 py-2 text-sm rounded-lg bg-red-500 text-white hover:bg-red-600 transition"
                                    data-id="@s.TestSectionId">

                                <i class="bi bi-trash"></i>
                                Delete

                            </button>

                        </div>

                    </div>

                }

            </div>

        }

    </div>

</div>

<div id="deleteModal"
     class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">

    <div class="bg-white rounded-xl p-6 w-96 shadow-xl">

        <h2 class="text-lg font-semibold mb-3">
            Delete Section
        </h2>

        <p class="text-gray-500 text-sm mb-6">
            Are you sure you want to delete this section?
        </p>

        <div class="flex justify-end gap-3">

            <button id="cancelDelete"
                    class="px-4 py-2 border rounded-lg hover:bg-gray-50">
                Cancel
            </button>

            <button id="confirmDelete"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                Delete
            </button>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const items = document.querySelectorAll(".searchable");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            items.forEach(item => {

                const text = item.innerText.toLowerCase();

                item.style.display = text.includes(value)
                    ? "block"
                    : "none";

            });

        });


        let deleteId = null

        const modal = document.getElementById("deleteModal")
        const confirmDelete = document.getElementById("confirmDelete")
        const cancelDelete = document.getElementById("cancelDelete")

        document.querySelectorAll(".deleteBtn").forEach(btn => {

            btn.onclick = () => {

                deleteId = btn.dataset.id

                modal.classList.remove("hidden")
                modal.classList.add("flex")

            }

        })

        cancelDelete.onclick = () => {

            modal.classList.add("hidden")

        }

        confirmDelete.onclick = () => {

            fetch("/TestSection/Delete/" + deleteId, {
                method: "POST"
            })
            .then(res => {
                if (res.ok) {

                    const row = document.getElementById("row-" + deleteId)

                    row.style.opacity = "0"

                    setTimeout(() => {
                        row.remove()
                    }, 200)

                    modal.classList.add("hidden")

                } else {

                    alert("Delete failed")

                }
            })

        }

    </script>

}