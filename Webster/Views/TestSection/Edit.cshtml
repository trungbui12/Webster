@model Webster.Models.ViewModels.TestSectionEditVM
@{
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-semibold text-gray-800">
            Edit Test Section
        </h2>

        <a asp-action="Index"
           class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
            Back
        </a>
    </div>


    <!-- Card -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">

        <form asp-action="Edit" method="post" class="space-y-6">

            <input type="hidden" asp-for="TestSectionId" />

            <!-- Section Type -->
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">
                    Section Type
                </label>

                <select asp-for="SectionType"
                        asp-items="Html.GetEnumSelectList<Webster.Models.Enums.TestSectionType>()"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500">
                </select>
            </div>


            <!-- Duration -->
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">
                    Duration (minutes)
                </label>

                <input asp-for="DurationInMinutes"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500" />
            </div>


            <!-- Total Questions -->
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">
                    Total Questions
                </label>

                <input asp-for="TotalQuestions"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500" />
            </div>


            <!-- Buttons -->
            <div class="flex gap-3 pt-2">

                <button type="submit"
                        class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="bg-gray-300 px-6 py-2 rounded-lg hover:bg-gray-400 transition">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>